{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Default configuration for repositories in the Webinertia organisation",
    "extends": [
        ":dependencyDashboard",
        ":ignoreModulesAndTests",
        ":rebaseStalePrs",
        ":semanticCommitsDisabled",
        ":separateMajorReleases",
        ":combinePatchMinorReleases",
        ":enableVulnerabilityAlerts",
        ":timezone(UTC)",
        ":gitSignOff",
        ":label(renovate)",
        "group:allNonMajor"
    ],
    "commitBodyTable": true,
    "lockFileMaintenance": {"enabled": true, "extends": ["schedule:weekly"]},
    "automerge": false,
    "platformAutomerge": false,
    "prFooter": "[Read more information](https://github.com/webinertia/.github/blob/master/renovate.md) about the use of [Renovate Bot](https://github.com/renovatebot/renovate).",
    "rangeStrategy": "replace",
    "rollbackPrs": true,
    "packageRules": [
        {"matchDepTypes": ["require"], "rangeStrategy": "widen"},
        {
            "description": "Webware components always move to the latest release, so replace the constraint with the new floor instead of widening it. Widening turns a constraint into an OR-range (^1.0 || ^2.0), which prefer-stable then resolves back to the older stable line, and which grows a duplicate alternative on the next release (^1.0 || ^2.0 || ^2.0).",
            "matchPackageNames": ["webware/**", "webinertia/**"],
            "rangeStrategy": "replace"
        },
        {
            "description": "Webware components: group updates and track their prereleases",
            "matchPackageNames": ["webware/**"],
            "groupSlug": "webware",
            "groupName": "Webware packages",
            "ignoreUnstable": false,
            "respectLatest": false
        },
        {
            "matchPackageNames": ["php"],
            "allowedVersions": "^8.4.1",
            "extends": [":automergeDisabled", ":automergePr", ":label(Awaiting Maintainer Response)"],
            "ignoreUnstable": false,
            "groupName": "PHP"
        }
    ],
    "vulnerabilityAlerts": {
        "extends": [":automergeDisabled", ":automergePr", ":labels(Awaiting Maintainer Response, security)"],
        "rangeStrategy": "bump"
    }
}